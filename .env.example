# LLM Provider Configuration
# Choose one: "openai", "anthropic", or "gemini"
LLM_PROVIDER=openai

# Model selection (examples below - adjust as needed)
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Gemini: gemini-1.5-pro-latest, gemini-1.5-flash
LLM_MODEL=gpt-4o

# API Keys
# Only set the keys for providers you plan to use
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# Image Generation (NanoBanana)
# This should remain as Gemini's flash image model
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp
